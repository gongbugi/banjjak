{
  "uid": "banjjak-sli",
  "title": "banjjak SLI",
  "schemaVersion": 39,
  "editable": false,
  "refresh": "1m",
  "time": {"from": "now-24h", "to": "now"},
  "panels": [
    {
      "id": 1, "type": "stat", "title": "데이터 나이 (목표 2시간 이내)",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 6},
      "datasource": {"type": "prometheus", "uid": "prom"},
      "targets": [{"refId": "A", "expr": "max(banjjak_data_age_seconds)"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [
        {"color": "green", "value": null}, {"color": "red", "value": 7200}]}}, "overrides": []}
    },
    {
      "id": 2, "type": "timeseries", "title": "웹 p95 (목표 500ms, 화면 요청만)",
      "gridPos": {"x": 6, "y": 0, "w": 9, "h": 6},
      "datasource": {"type": "prometheus", "uid": "prom"},
      "targets": [{"refId": "A", "legendFormat": "p95",
        "expr": "histogram_quantile(0.95, sum by (le) (rate(banjjak_http_request_duration_seconds_bucket{route=~\"/|/api/trending\"}[5m])))"}],
      "fieldConfig": {"defaults": {"noValue": "화면 요청 없음", "unit": "s", "custom": {"thresholdsStyle": {"mode": "line"}},
        "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.5}]}}, "overrides": []}
    },
    {
      "id": 3, "type": "timeseries", "title": "웹 5xx 비율 (화면 요청만)",
      "gridPos": {"x": 15, "y": 0, "w": 9, "h": 6},
      "datasource": {"type": "prometheus", "uid": "prom"},
      "targets": [{"refId": "A", "legendFormat": "5xx",
        "expr": "(sum(rate(banjjak_http_request_duration_seconds_count{route=~\"/|/api/trending\", status=~\"5..\"}[5m])) or vector(0)) / sum(rate(banjjak_http_request_duration_seconds_count{route=~\"/|/api/trending\"}[5m]))"}],
      "fieldConfig": {"defaults": {"noValue": "화면 요청 없음", "unit": "percentunit", "custom": {"thresholdsStyle": {"mode": "line"}},
        "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.05}]}}, "overrides": []}
    },
    {
      "id": 4, "type": "timeseries", "title": "데이터 나이",
      "gridPos": {"x": 0, "y": 6, "w": 12, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prom"},
      "targets": [{"refId": "A", "legendFormat": "나이", "expr": "max(banjjak_data_age_seconds)"}],
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"thresholdsStyle": {"mode": "line"}},
        "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 7200}]}}, "overrides": []}
    },
    {
      "id": 5, "type": "timeseries", "title": "초당 요청 (경로별)",
      "gridPos": {"x": 12, "y": 6, "w": 12, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prom"},
      "targets": [{"refId": "A", "legendFormat": "{{route}} {{status}}",
        "expr": "sum by (route, status) (rate(banjjak_http_request_duration_seconds_count[5m]))"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}
    },
    {
      "id": 6, "type": "timeseries", "title": "화면 요청: 합성(운영 VM 프로브) / 실제",
      "gridPos": {"x": 0, "y": 13, "w": 24, "h": 6},
      "datasource": {"type": "prometheus", "uid": "prom"},
      "targets": [{"refId": "A", "legendFormat": "{{source}}",
        "expr": "sum by (source) (rate(banjjak_http_request_duration_seconds_count{route=~\"/|/api/trending\"}[5m]))"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "noValue": "화면 요청 없음"}, "overrides": []}
    },
    {
      "id": 7, "type": "timeseries", "title": "입구 응답 코드 (Traefik): 429 요청 제한 · 502/503/504 웹 못 닿음",
      "gridPos": {"x": 0, "y": 19, "w": 24, "h": 6},
      "datasource": {"type": "prometheus", "uid": "prom"},
      "targets": [{"refId": "A", "legendFormat": "{{code}}",
        "expr": "sum by (code) (rate(traefik_entrypoint_requests_total{entrypoint=\"web\"}[2m]))"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "noValue": "입구 지표 없음"}, "overrides": []}
    }
  ]
}
